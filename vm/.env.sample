PUID=1028 # same ids as the NAS: NFS checks numeric ids, and migrated data needs no chown
PGID=65536
TIMEZONE=Europe/Madrid
DOMAIN=lab.jomafamily.com # base subdomain, e.g. movies.${DOMAIN}
NAS_LAN_IP=10.185.0.33
HA_LAN_IP=10.185.0.201
DOCKER_LAN_IP=10.185.0.202
DOCKER_ROOT=/opt/docker # app configs, on the VM's local disk
DATA_ROOT=/mnt/data # NFS mount of 10.185.0.33:/volume1/data
CF_DNS_API_TOKEN= # Cloudflare API token scoped to Zone:DNS:Edit
ACME_EMAIL= # Let's Encrypt renewal notices
ACTUAL_PASSWORD= # password for your Actual Budget server
ACTUAL_BUDGET_SYNC_ID= # Actual: Settings > Show advanced settings > Sync ID
ACTUAL_MCP_BEARER_TOKEN= # long random secret, e.g. `openssl rand -hex 32`
